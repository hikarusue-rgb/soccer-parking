rules_version = '2';

// 合言葉なしで誰でも要項の画像・PDFを追加・削除できる（2026-11-02 ユーザー判断「コーチの合言葉もなしでOK」）。
// 種類（画像・PDF）と大きさ（15MB未満）の制限、既存ファイルの上書き禁止、置き場所の制限は残す。
// 本番 /mss とテスト環境 /mss_test は同じルール。
service firebase.storage {
  match /b/{bucket}/o {
    function validGrade(grade) {
      return grade.matches('^(k|g[1-6])$');
    }
    function validUpload() {
      // resource == null: 既存ファイルの上書きはさせない（ファイル名は毎回新しいIDにする）
      return resource == null
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
          || request.resource.contentType == 'application/pdf');
    }

    match /{root}/{grade}/files/{fileName} {
      allow read, delete: if (root == 'mss' || root == 'mss_test') && validGrade(grade);
      allow create: if (root == 'mss' || root == 'mss_test') && validGrade(grade) && validUpload();
    }
  }
}
