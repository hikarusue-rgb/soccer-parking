              }
            }
          }
        },
        "lotteries": {
          "$eventId": {
            ".write": "$grade.matches(/^(k|g[1-6])$/)",
            ".validate": "newData.hasChildren(['status', 'updatedAt'])",
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(drawn)$/)"
            },
