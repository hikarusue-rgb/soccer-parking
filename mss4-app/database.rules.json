{
  "rules": {
    "mss_acl": {
      ".read": false,
      ".write": false
    },
    "mss": {
      "$grade": {
        ".read": "$grade.matches(/^(k|g[1-6])$/)",
        "meta": {
          ".write": "$grade.matches(/^(k|g[1-6])$/)"
        },
        "settings": {
          ".write": "$grade.matches(/^(k|g[1-6])$/)"
        },
        "events": {
          ".indexOn": [
            "date"
          ],
          "$eventId": {
            ".write": "$grade.matches(/^(k|g[1-6])$/)",
            ".validate": "$eventId.matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.hasChildren(['date', 'kind', 'title', 'status', 'version', 'updatedAt']) && (data.exists() ? newData.child('version').val() === data.child('version').val() + 1 : newData.child('version').val() === 1)",
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^20[0-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
            },
            "kind": {
              ".validate": "newData.isString() && newData.val().matches(/^(practice|match|notice)$/)"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(scheduled|changed|canceled|postponed|unconfirmed)$/)"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
            },
            "start": {
              ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
            },
            "end": {
              ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
            },
            "meeting": {
              ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
            },
            "kickoff": {
              ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
            },
            "tournamentId": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,64}$/)"
            },
            "version": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.val() === now"
            },
            "parking": {
              "mode": {
                ".validate": "newData.isString() && newData.val().matches(/^(none|lottery)$/)"
              },
              "limit": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
              },
              "deadlineAt": {
                ".validate": "newData.isNumber()"
              }
            }
          }
        },
        "history": {
          "$eventId": {
            "$historyId": {
              ".write": "$grade.matches(/^(k|g[1-6])$/) && !data.exists() && newData.exists()",
              ".validate": "newData.hasChildren(['at', 'version', 'after']) && newData.child('at').val() === now"
            }
          }
        },
        "tournaments": {
          "$tournamentId": {
            ".write": "$grade.matches(/^(k|g[1-6])$/)",
            ".validate": "$tournamentId.matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.hasChildren(['name', 'version', 'updatedAt']) && (data.exists() ? newData.child('version').val() === data.child('version').val() + 1 : newData.child('version').val() === 1)"
          }
        },
        "members": {
          "$memberId": {
            ".write": "$grade.matches(/^(k|g[1-6])$/)",
            ".validate": "$memberId.matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.hasChildren(['num', 'name', 'active'])",
            "num": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "active": {
              ".validate": "newData.isBoolean()"
            },
            "order": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "entries": {
          "$eventId": {
            ".write": "$grade.matches(/^(k|g[1-6])$/)",
            "$memberId": {
              ".write": "newData.exists() && root.child('mss').child($grade).child('members').child($memberId).exists() && root.child('mss').child($grade).child('events').child($eventId).child('parking/mode').val() === 'lottery' && (newData.child('parkingNeeded').val() === false || data.child('parkingNeeded').val() === true || (!root.child('mss').child($grade).child('lotteries').child($eventId).exists() && (!data.exists() || !root.child('mss').child($grade).child('events').child($eventId).child('parking/deadlineAt').exists() || now < root.child('mss').child($grade).child('events').child($eventId).child('parking/deadlineAt').val())))",
              ".validate": "newData.hasChildren(['attending', 'parkingNeeded', 'carpoolCapacity', 'at']) && (newData.child('attending').val() === true || newData.child('parkingNeeded').val() === false)",
              "attending": {
                ".validate": "newData.isBoolean()"
              },
              "parkingNeeded": {
                ".validate": "newData.isBoolean()"
              },
              "carpoolCapacity": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "lotteries": {
          "$eventId": {
            ".write": "$grade.matches(/^(k|g[1-6])$/)",
            ".validate": "newData.hasChildren(['status', 'updatedAt'])",
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(drawn)$/)"
            },
            "updatedAt": {
              ".validate": "newData.val() === now"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
