            },
            "active": {
              ".validate": "newData.isBoolean()"
            },
            "order": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "entries": {
          "$eventId": {
            ".write": "$grade.matches(/^(k|g[1-6])$/)",
            "$memberId": {
              ".write": "newData.exists() && root.child('mss_test').child($grade).child('members').child($memberId).exists() && root.child('mss_test').child($grade).child('events').child($eventId).child('parking/mode').val() === 'lottery' && (newData.child('parkingNeeded').val() === false || data.child('parkingNeeded').val() === true || (!root.child('mss_test').child($grade).child('lotteries').child($eventId).exists() && (!data.exists() || !root.child('mss_test').child($grade).child('events').child($eventId).child('parking/deadlineAt').exists() || now < root.child('mss_test').child($grade).child('events').child($eventId).child('parking/deadlineAt').val())))",
              ".validate": "newData.hasChildren(['attending', 'parkingNeeded', 'carpoolCapacity', 'at']) && (newData.child('attending').val() === true || newData.child('parkingNeeded').val() === false)",
              "attending": {
                ".validate": "newData.isBoolean()"
              },
              "parkingNeeded": {
                ".validate": "newData.isBoolean()"
              },
              "carpoolCapacity": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
              },
              "at": {
